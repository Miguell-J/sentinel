# Copy to .env and replace both credentials with different random secrets.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SENTINEL_INGEST_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
SENTINEL_PORT=8080
# WhatsApp endpoints fail closed when these are empty.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
